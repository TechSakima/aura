# Web app config (Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public app URL (emails + OAuth callbacks)
NEXT_PUBLIC_APP_URL=https://aura.stroburm.app

# Resend — verified domain aura.stroburm.app (platform From; Reply-To = studio)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aura <notify@aura.stroburm.app>

# Stripe Connect (Phase 6b)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Calendar (Phase 6d)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin SDK — prefer dropping serviceAccountKey.json in project root
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Or paste service account fields instead of a JSON file:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
