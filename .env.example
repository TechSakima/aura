# Web app config (Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public app URL (emails + OAuth callbacks)
NEXT_PUBLIC_APP_URL=https://aura.stroburm.app

# Resend — full setup: docs/RESEND.md (Tier 1 send · Tier 2 cron · Tier 3 inbound)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aura <notify@aura.stroburm.app>
# CRON_SECRET=
# RESEND_WEBHOOK_SECRET=
# RESEND_INBOUND_DOMAIN=inbound.aura.stroburm.app

# Stripe Connect (Phase 6b)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Calendar — platform OAuth client; each studio stores its own refresh token
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: AES key material for sealing refresh tokens at rest (AURA-109).
# Falls back to AURA_SESSION_SECRET → HOMEPAGE_UNLOCK_SECRET → GOOGLE_CLIENT_SECRET → APP URL.
# Rotating it requires reconnecting Google Calendar for each studio.
# GOOGLE_TOKEN_SECRET=

# Admin SDK — prefer dropping serviceAccountKey.json in project root
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Or paste service account fields instead of a JSON file:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Cloudflare R2 — gallery media (required in production / App Hosting — AURA-360)
# Enable R2 + create bucket + API token: docs/CLOUDFLARE_R2.md
# Local without R2 falls back to Firebase Storage for writes; prod does not.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aura-media
# Optional: MEDIA_DUAL_READ=0 to stop Firebase Storage dual-read/delete after cutover
# MEDIA_DUAL_READ=1

# Optional: AURA_LEGACY_COLLECTIONS=0 to never read deprecated clients/shoots (AURA-273)
# Default on: empty-canonical studios still backfill once from legacy docs.
# AURA_LEGACY_COLLECTIONS=1

# Optional: salt for private homepage unlock cookies (AURA-234); falls back to APP URL
# HOMEPAGE_UNLOCK_SECRET=

# Optional: HMAC secret for signed admin session cookies (AURA-104).
# Falls back to HOMEPAGE_UNLOCK_SECRET → NEXT_PUBLIC_APP_URL → "aura-session".
# Set a long random value in production (rotating it signs everyone out).
# AURA_SESSION_SECRET=

# Optional: analyticsEvents retention (AURA-117). Defaults: 180 days, 8000/studio soft cap.
# AURA_ANALYTICS_RETENTION_DAYS=180
# AURA_ANALYTICS_MAX_PER_STUDIO=8000
