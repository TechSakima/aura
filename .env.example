# Web app config (Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public app URL (emails + OAuth callbacks)
NEXT_PUBLIC_APP_URL=https://aura.stroburm.app

# Resend — full setup: docs/RESEND.md (Tier 1 send · Tier 2 cron · Tier 3 inbound)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aura <notify@aura.stroburm.app>
# CRON_SECRET=
# RESEND_WEBHOOK_SECRET=
# RESEND_INBOUND_DOMAIN=inbound.aura.stroburm.app

# Stripe Connect (Phase 6b)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Calendar — platform OAuth client; each studio stores its own refresh token
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: AES key material for sealing refresh tokens at rest (AURA-109 / AURA-389).
# Prod chain: GOOGLE_TOKEN_SECRET → AURA_SESSION_SECRET → HOMEPAGE_UNLOCK_SECRET → GOOGLE_CLIENT_SECRET.
# Never NEXT_PUBLIC_* / APP URL. Rotating requires reconnecting Google Calendar per studio.
# GOOGLE_TOKEN_SECRET=

# Admin SDK — prefer dropping serviceAccountKey.json in project root
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Or paste service account fields instead of a JSON file:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Cloudflare R2 — gallery media (required in production / App Hosting — AURA-360)
# Enable R2 + create bucket + API token: docs/CLOUDFLARE_R2.md
# Local without R2 falls back to Firebase Storage for writes; prod does not.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aura-media
# Optional: MEDIA_DUAL_READ=0 to stop Firebase Storage dual-read/delete after cutover
# MEDIA_DUAL_READ=1

# Optional: AURA_LEGACY_COLLECTIONS=0 to never read deprecated Firestore clients/shoots (AURA-273/384)
# API aliases /api/clients and /api/shoots are 410 Gone; this flag is Firestore backfill only.
# Default on: empty-canonical studios still backfill once from legacy docs.
# AURA_LEGACY_COLLECTIONS=1

# Crypto secrets (AURA-389) — required in production (App Hosting secrets).
# Never use NEXT_PUBLIC_* or APP URL as HMAC material. Dev may omit (local literals).
#
# Required in prod (covers session + can back media/homepage/Google seal):
#   firebase apphosting:secrets:set AURA_SESSION_SECRET --data-file -
# AURA_SESSION_SECRET=
#
# Optional dedicated salts (preferred over sharing AURA_SESSION_SECRET):
# HOMEPAGE_UNLOCK_SECRET=
# MEDIA_PROXY_SECRET=
# GOOGLE_TOKEN_SECRET=

# CSP (AURA-390): default is Content-Security-Policy-Report-Only.
# Set to 1 after reviewing /api/csp-report logs to enforce.
# AURA_CSP_ENFORCE=0

# Admin mutating API Origin/Referer allowlist (AURA-415) — beyond SameSite=Lax.
# Default: on in production when NEXT_PUBLIC_APP_URL / APP_URL is set.
# Force on (incl. local): AURA_ADMIN_ORIGIN_CHECK=1 · force off: =0
# AURA_ADMIN_ORIGIN_CHECK=1
# Extra origins (preview / firebaseapp hosts), comma-separated:
# AURA_ADMIN_ORIGINS=https://aura-photo-manager.web.app,https://aura--aura-photo-manager.us-east4.hosted.app

# Optional: analyticsEvents retention (AURA-117). Defaults: 180 days, 8000/studio soft cap.
# AURA_ANALYTICS_RETENTION_DAYS=180
# AURA_ANALYTICS_MAX_PER_STUDIO=8000
