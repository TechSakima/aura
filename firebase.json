{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".data/**",
      "serviceAccountKey.json",
      "**/*.md"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  }
}
